# Copy to memory.env on the deployment host only. Never paste completed values in chat.
# Generate a unique random secret with at least 32 bytes of entropy.
OMNI_MEMORY_SESSION_SECRET=
OMNI_APPLE_BUNDLE_ID=omni.ai.Omni
OMNI_APPLE_TEAM_ID=MGFX73F82F
OMNI_APPLE_SIGNIN_KEY_ID=
OMNI_APPLE_SIGNIN_KEY_PATH=/run/omni-secrets/signin.p8
OMNI_APPLE_IAP_KEY_ID=
OMNI_APPLE_ISSUER_ID=
OMNI_APPLE_IAP_KEY_PATH=/run/omni-secrets/store.p8
# Download Apple trust anchors directly from Apple; colon-separated DER paths.
OMNI_APPLE_ROOT_CERTIFICATES=/run/omni-secrets/AppleRootCA-G3.cer
OMNI_APPLE_PLUS_PRODUCT_IDS=omni.ai.Omni.plus.monthly,omni.ai.Omni.plus.yearly
# Sandbox is for an isolated test service. The submission/production service may
# explicitly use ProductionAndSandbox to verify both Apple-signed environments.
# Production and ProductionAndSandbox require the real numeric app ID below.
# Never use Xcode or LocalTesting on a deployed server.
OMNI_APPLE_STORE_ENVIRONMENT=Sandbox
OMNI_APPLE_APP_ID=6812658396
OPENAI_API_KEY=
# Select the intended Responses-compatible model explicitly; there is no billed default.
OMNI_MEMORY_MODEL=
